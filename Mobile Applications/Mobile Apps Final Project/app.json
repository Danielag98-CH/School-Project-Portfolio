{
  "expo": {
    "name": "mobile-apps-final",
    "slug": "mobile-apps-final",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/apothecary.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/apothecary.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset"
    ]
  }
}
