<!DOCTYPE html>
<html lang="en">
	<head>
		<title><%= title %></title>
	  <meta charset="utf-8">
	  <meta name="viewport" content="width=device-width, initial-scale=1" />
	  <meta name="description" content="A blog about programming, web development, and other crazy ideas!">
		<link rel="stylesheet" type="text/css" href="/css/main.css">
		<link rel="stylesheet" href="/css/bootstrap.min.css">
		<link rel="stylesheet" href="/prism/prism.css">
		<script src="/js/main.js"></script>
		<script src="/prism/prism.js"></script>
		<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>
		<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>
	</head>
	<!-- <body> -->
	<body data-document-class="<%= docClass %>"> 
		<header class="text-center">
			<small>
				<em>"Man cannot discover new oceans unless he has the courage to lose sight of the shore." -Andre Gide</em>
			</small>
		</header>
		<nav class="navbar navbar-expand-lg bg-light text-primary-emphasis" data-bs-theme="light">
			<div class="container-fluid">
				<a class="navbar-brand d-flex align-items-center" href="/" aria-label="Crazy Creations Home Page">Crazy Creations
				<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-cloud-moon-fill me-2" viewBox="0 0 16 16">
					<path d="M11.473 11a4.5 4.5 0 0 0-8.72-.99A3 3 0 0 0 3 16h8.5a2.5 2.5 0 0 0 0-5z"/>
					<path d="M11.286 1.778a.5.5 0 0 0-.565-.755 4.595 4.595 0 0 0-3.18 5.003 5.5 5.5 0 0 1 1.055.209A3.6 3.6 0 0 1 9.83 2.617a4.593 4.593 0 0 0 4.31 5.744 3.58 3.58 0 0 1-2.241.634q.244.477.394 1a4.59 4.59 0 0 0 3.624-2.04.5.5 0 0 0-.565-.755 3.593 3.593 0 0 1-4.065-5.422z"/>
				</svg>
				</a>
				<button class="navbar-toggler " type="button" data-bs-toggle="collapse" data-bs-target="#navbarColor03" aria-controls="navbarColor03" aria-expanded="false" aria-label="Toggle navigation">
					<span class="navbar-toggler-icon"></span>
				</button>
				<div class="collapse navbar-collapse text-center" id="navbarColor03">
					<ul class="navbar-nav me-auto">
						<hr>
						<li class="nav-item">
							<a class="nav-link active text-primary-emphasis" href="/">Home
								<span class="visually-hidden">(current)</span>
							</a>
						</li>
						<hr>
						<li class="nav-item dropdown">
							<a class="nav-link dropdown-toggle text-primary-emphasis" id="navbarDropdown" data-bs-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false" aria-labelledby="navbarDropdown">Blogs</a>
							<div class="dropdown-menu" aria-labelledby="navbarDropdown">
								<% if (posts && posts.length > 0) { %>
								<% for (let i = 0; i < posts.length; i++) { %>
									<a class="dropdown-item" href="/blog/<%= posts[i].slug %>" aria-label="Read blog post titled: <%= posts[i].title %>"
										title="Read blog post titled: <%= posts[i].title %>">
										<%=posts[i].title%>
									</a>
								<% } %>
								<% } else { %>
									<span class="dropdown-item text-muted">No blogs available</span>
								<% } %>
								<div class="dropdown-divider text-primary-emphasis"></div>
								<a class="dropdown-item text-primary-emphasis" href="/blog">Here are Some Blogs</a>
							</div>
						</li>
						<hr>
						<li class="nav-item">
							<a class="nav-link text-primary-emphasis" href="/contact" aria-label="Crazy Creations Contact Page">Contact Us</a>
						</li>
						<hr>
					</ul>
				</div>
			</div>
		</nav>
		<div id="content">